NODE_ENV=development
PORT=4000

# Transactions (wallet credits) need a replica set
MONGO_URI=mongodb://127.0.0.1:27017/chess_platform?replicaSet=rs0

# Use long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated origins of the admin web portal / player web
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Number of proxies in front of the app (1 behind nginx / ALB)
TRUST_PROXY=0

# Where reset-password links point
APP_URL=http://localhost:3000

# razorpay | mock (mock is refused in production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# First super admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_SAMPLE_DATA=true
